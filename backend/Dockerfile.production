# syntax=docker/dockerfile:1

# ── Build stage ──────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY backend.csproj ./
RUN dotnet restore ./backend.csproj

COPY . .
RUN dotnet publish ./backend.csproj -c Release -o /app/publish

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:9.0-alpine AS final
WORKDIR /app

# Required for SkiaSharp / QuestPDF PDF generation
RUN apk add --no-cache \
    icu-libs \
    libintl \
    fontconfig \
    ttf-dejavu

COPY --from=build /app/publish .

# Copy the SQL init script for first-run schema creation
COPY init_postgres.sql .

# Railway injects $PORT at runtime — we read it via ASPNETCORE_URLS
ENV ASPNETCORE_ENVIRONMENT=Production
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false

# Railway sets PORT; expose a default for local testing
EXPOSE 5213

# Use shell form so $PORT is expanded at runtime
CMD ASPNETCORE_URLS="http://0.0.0.0:${PORT:-5213}" dotnet backend.dll
