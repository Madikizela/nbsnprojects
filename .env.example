# Admin Credentials (for initial seeding)
DEFAULT_ADMIN_EMAIL=admin@system.local
DEFAULT_ADMIN_PASSWORD=Admin@123!System

# Frontend Settings
VITE_API_URL=http://localhost:5213

# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rlms
DB_USER=postgres
DB_PASS=your_password_here

# JWT Settings
JWT_SECRET=your_super_secret_key_here_at_least_32_chars
JWT_ISSUER=DocumentManagementSystem
JWT_AUDIENCE=DocumentManagementUsers
JWT_EXPIRY_MINUTES=60

# Encryption
ENCRYPTION_DATA_KEY=your_encryption_key_here

# Email Settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
FROM_EMAIL=your_email@gmail.com
FROM_NAME=NBSN Team

# WhatsApp Business API (Meta Cloud API)
# Get these from https://developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here

# Learner Portal URL (sent in welcome WhatsApp messages)
LEARNER_PORTAL_URL=http://localhost:5174/learner
