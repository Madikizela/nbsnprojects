# syntax=docker/dockerfile:1

# ── Build stage ───────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# VITE_API_URL is passed as build arg from Railway environment variable
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ── Production stage (nginx) ──────────────────────────────────────────────────
FROM nginx:alpine AS final

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/nginx.conf.template

# Railway injects $PORT and $BACKEND_URL at runtime
EXPOSE 80

# Use sed to substitute placeholder strings (avoids envsubst clobbering nginx variables like $host)
# BACKEND_URL must be set in Railway Variables, e.g. https://nbsnprojects-production.up.railway.app
CMD ["/bin/sh", "-c", \
  "sed -e \"s|NGINX_PORT|${PORT:-80}|g\" \
       -e \"s|NGINX_BACKEND_URL|${BACKEND_URL}|g\" \
       /etc/nginx/nginx.conf.template > /etc/nginx/conf.d/default.conf \
  && nginx -g 'daemon off;'"]
